# Copy to .env and adjust for your machine.
# The backend reads all of these at startup.

# Where to listen, e.g. 127.0.0.1:3030 (dev) or 0.0.0.0:3030 (docker).
LISTEN_ADDR=127.0.0.1:3030

# Database. SQLite for dev, MySQL for production (once the mysql feature is enabled).
DATABASE_URL=sqlite://./dev.sqlite

# CORS: set to the frontend origin in dev, e.g. http://localhost:4201.
# Leave empty to disable the Access-Control-Allow-Origin header.
CORS_ORIGIN=
